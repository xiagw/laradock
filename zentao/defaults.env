ZENTAO_VERSION=22.4

ZENTAO_PORT=8086

ZENTAO_MYSQL_INTERNAL=false
ZENTAO_MYSQL_HOST=mysql
ZENTAO_MYSQL_PORT=3306
ZENTAO_MYSQL_USER=root
ZENTAO_MYSQL_PASSWORD=${MYSQL_ROOT_PASSWORD}
ZENTAO_MYSQL_DB=zentao

ZENTAO_PHP_MAX_EXECUTION_TIME=120
ZENTAO_PHP_MEMORY_LIMIT=256M
ZENTAO_PHP_POST_MAX_SIZE=1024M
ZENTAO_PHP_UPLOAD_MAX_FILESIZE=1024M

ZENTAO_REDIS_INTERNAL=false
# ZENTAO_PHP_SESSION_TYPE=files
ZENTAO_PHP_SESSION_TYPE=redis
# ZENTAO_PHP_SESSION_PATH="tcp://redis:6379?auth=${REDIS_PASSWORD}"
# ZENTAO_PHP_SESSION_REDIS_DATABASE=6
ZENTAO_REDIS_HOST=redis
ZENTAO_REDIS_PORT=6379
ZENTAO_REDIS_PASSWORD=${REDIS_PASSWORD}

ZENTAO_SMTP_ENABLED=false
ZENTAO_SMTP_FROMNAME=ZenTao
ZENTAO_SMTP_HOST=127.0.0.1
ZENTAO_SMTP_PORT=25
ZENTAO_SMTP_USER=zentao@easycorp.cn
